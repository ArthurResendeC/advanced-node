{
  "name": "advanced-node",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch src/main/api/index.ts",
    "start": "bun src/main/api/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main/api/index.ts --outdir dist --target bun --sourcemap",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "lint:staged": "lint-staged --hide-all"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lint-staged": "^17.5.1",
    "module-alias": "^2.3.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
