{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2024",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
    },
    "types": ["node", "bun"],
    "strict": true
  },
  "include": ["src"]
}
