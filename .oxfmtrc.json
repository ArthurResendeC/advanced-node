{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "printWidth": 80,
  "ignorePatterns": [
    "dist/**",
    "bun.lock",
    "playwright-report/**",
    "test-results/**",
    "deploy/**",
    "/coverage/**"
  ]
}
